# Provedor de LLM: "mock" (padrão local sem custos) ou "openai_compatible"
ARCHON_LLM_PROVIDER=mock

# Configurações para provedores compatíveis com a API OpenAI (OpenAI, Gemini OpenAI endpoint, OpenRouter, Ollama, etc.)
ARCHON_API_KEY=sua_chave_api_aqui
ARCHON_API_BASE_URL=https://api.openai.com/v1
ARCHON_MODEL=gpt-4o-mini

# Supervisão e execução
ARCHON_MAX_RETRIES=2
ARCHON_LOG_LEVEL=INFO
